{
  "name": "chorotate",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:schema:check": "node scripts/auth/check-auth-schema.mjs",
    "auth:schema:generate": "auth generate --config scripts/auth/better-auth-schema.ts --output migrations/0004_better_auth.sql --adapter kysely --dialect sqlite --yes",
    "build": "react-router build",
    "check": "npm run format:check && npm run lint && npm run auth:schema:check && npm run cf-typegen:check && npm run typecheck && npm test && npm run test:workerd",
    "check:release": "node scripts/quality/release-gate.mjs",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "dev": "react-router dev",
    "deploy": "node scripts/deployment/production-deploy.mjs",
    "deploy:production": "node scripts/deployment/production-deploy.mjs deploy",
    "deploy:production:dry-run": "node scripts/deployment/production-deploy.mjs dry-run",
    "deploy:production:test": "node --test scripts/deployment/production-deploy.test.mjs",
    "doctor": "node scripts/quality/doctor.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "operator:bootstrap:prepare": "node scripts/operator/operator-contact-config.mjs --bootstrap",
    "operator:bootstrap:local": "node scripts/operator/local-bootstrap.mjs",
    "operator:contacts:prepare": "node scripts/operator/operator-contact-config.mjs",
    "operator:contacts:test": "node --test scripts/operator/operator-contact-config.test.mjs scripts/operator/local-bootstrap.test.mjs",
    "operator:d1:execute": "node scripts/operator/production-d1-operator.mjs execute",
    "operator:d1:migrations:apply": "node scripts/operator/production-d1-operator.mjs migrations-apply",
    "operator:d1:migrations:list": "node scripts/operator/production-d1-operator.mjs migrations-list",
    "operator:d1:test": "node --test scripts/operator/production-d1-operator.test.mjs",
    "operator:d1:verify": "node scripts/operator/verify-production-d1.mjs",
    "operator:d1:verify:dry-run": "node scripts/operator/verify-production-d1.mjs --dry-run",
    "preview": "npm run build && vite preview",
    "seed:local": "wrangler d1 execute chorotate-local --local --file seed/chorotate-local.template.sql",
    "postinstall": "npm run cf-typegen",
    "quality:contracts": "node scripts/quality/quality-contracts.mjs",
    "scan:secrets": "node scripts/quality/secret-scan.mjs",
    "test": "vitest run",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "typecheck": "react-router typegen && tsc -b",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "isbot": "5.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "auth": "1.7.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}
